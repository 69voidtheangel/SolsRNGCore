from __future__ import annotations

import os
import shutil
import signal
import subprocess
import threading
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Callable

from .models import AutomationItem


class AutomationError(RuntimeError):
    pass


@dataclass
class WindowInfo:
    window_id: str
    title: str


@dataclass
class AutomationStatus:
    running: bool = False
    testing: bool = False
    message: str = "STOPPED"
    current_item: str = ""
    next_run_timestamp: float | None = None
    authenticated: bool = False
    authenticating: bool = False
    auth_error: str = ""
    game_window: str = ""
    previous_window: str = ""


class AutomationController:
    def __init__(
        self,
        *,
        backend: str = "auto",
        game_window_pattern: str = "Sober",
        on_status: Callable[[AutomationStatus], None] | None = None,
    ):
        self.backend = (
            backend or "auto"
        ).strip().lower()

        self.game_window_pattern = (
            game_window_pattern or "Sober"
        ).strip()

        self.on_status = on_status
        self.items: list[AutomationItem] = []

        self.status = AutomationStatus()

        self._thread: threading.Thread | None = None
        self._auth_thread: threading.Thread | None = None
        self._stop_event = threading.Event()

        self._socket_path: Path | None = None
        self._owned_ydotoold: subprocess.Popen | None = None

    # =========================================================
    # Authentication
    # =========================================================

    def authenticate_async(self):
        if self.status.authenticated:
            return

        if self.status.authenticating:
            return

        self.status.authenticating = True
        self.status.auth_error = ""
        self._emit_status()

        self._auth_thread = threading.Thread(
            target=self.authenticate,
            name="solsrng-automation-auth",
            daemon=True,
        )
        self._auth_thread.start()

    def authenticate(self) -> bool:
        try:
            backend = self._resolve_backend()

            if backend == "xdotool":
                self.status.authenticated = True
                self.status.auth_error = ""
                return True

            self._ensure_ydotoold()

            self.status.authenticated = True
            self.status.auth_error = ""
            return True

        except Exception as exc:
            self.status.authenticated = False
            self.status.auth_error = str(exc)
            return False

        finally:
            self.status.authenticating = False
            self._emit_status()

    def retry_authentication(self):
        self.status.authenticated = False
        self.status.auth_error = ""
        self.authenticate_async()

    # =========================================================
    # Backend
    # =========================================================

    def _resolve_backend(self) -> str:
        requested = self.backend or "auto"

        if requested == "ydotool":
            if shutil.which("ydotool") is None:
                raise AutomationError(
                    "ydotool is not installed."
                )
            return "ydotool"

        if requested == "xdotool":
            if shutil.which("xdotool") is None:
                raise AutomationError(
                    "xdotool is not installed."
                )
            return "xdotool"

        if requested == "auto":
            if shutil.which("ydotool"):
                return "ydotool"

            if shutil.which("xdotool"):
                return "xdotool"

            raise AutomationError(
                "No supported automation input backend was found."
            )

        raise AutomationError(
            f"Unknown automation backend: {requested}"
        )

    def _ensure_ydotoold(self):
        runtime = Path(
            os.environ.get(
                "XDG_RUNTIME_DIR",
                f"/run/user/{os.getuid()}",
            )
        )

        runtime.mkdir(
            parents=True,
            exist_ok=True,
        )

        socket_path = (
            runtime
            / ".solsrng_ydotool_socket"
        )

        self._socket_path = socket_path

        if socket_path.exists():
            return

        daemon = shutil.which("ydotoold")

        if daemon is None:
            raise AutomationError(
                "ydotoold is required for ydotool automation."
            )

        uid = os.getuid()
        gid = os.getgid()

        if shutil.which("pkexec"):
            command = [
                "pkexec",
                daemon,
                "--socket-path",
                str(socket_path),
                "--socket-perm",
                "0660",
                "--socket-own",
                f"{uid}:{gid}",
            ]
        else:
            command = [
                "sudo",
                "-n",
                "--",
                daemon,
                "--socket-path",
                str(socket_path),
                "--socket-perm",
                "0660",
                "--socket-own",
                f"{uid}:{gid}",
            ]

        self._owned_ydotoold = subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

        deadline = time.monotonic() + 5.0

        while time.monotonic() < deadline:
            if socket_path.exists():
                return

            if (
                self._owned_ydotoold.poll()
                is not None
            ):
                break

            time.sleep(0.1)

        raise AutomationError(
            "ydotoold could not be started."
        )

    # =========================================================
    # Window helpers
    # =========================================================

    def _run_window_command(self, *args: str):
        if not args:
            raise AutomationError(
                "No window command specified."
            )

        if shutil.which(args[0]) is None:
            raise AutomationError(
                f"{args[0]} is not installed."
            )

        try:
            return subprocess.run(
                list(args),
                capture_output=True,
                text=True,
                check=False,
                timeout=10.0,
            )
        except subprocess.TimeoutExpired:
            raise AutomationError(
                f"{args[0]} timed out."
            )

    def _is_kde_wayland(self) -> bool:
        session = os.environ.get("XDG_SESSION_TYPE", "").lower()
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()

        return (
            session == "wayland"
            and "kde" in desktop
            and shutil.which("wdotool") is not None
        )

    def _wdotool_command(self, *args: str):
        if not shutil.which("wdotool"):
            raise AutomationError(
                "wdotool is required for KDE Wayland automation."
            )

        return self._run_window_command(
            "wdotool",
            "--backend",
            "kde",
            *args,
        )

    def _get_active_window(self) -> WindowInfo:
        if self._is_kde_wayland():
            result = self._wdotool_command(
                "getactivewindow",
            )

            if result.returncode != 0:
                raise AutomationError(
                    "wdotool could not determine the active window."
                )

            window_id = result.stdout.strip()

            if not window_id:
                raise AutomationError(
                    "No active window was reported by wdotool."
                )

            title_result = self._wdotool_command(
                "getwindowname",
                window_id,
            )

            title = (
                title_result.stdout.strip()
                if title_result.returncode == 0
                else ""
            )

            return WindowInfo(
                window_id=window_id,
                title=title,
            )

        if shutil.which("xdotool"):
            result = self._run_window_command(
                "xdotool",
                "getactivewindow",
            )

            if result.returncode == 0:
                window_id = result.stdout.strip()

                if window_id:
                    title_result = self._run_window_command(
                        "xdotool",
                        "getwindowname",
                        window_id,
                    )

                    return WindowInfo(
                        window_id=window_id,
                        title=(
                            title_result.stdout.strip()
                            if title_result.returncode == 0
                            else ""
                        ),
                    )

        raise AutomationError(
            "Could not determine the active window."
        )

    def _find_kde_window_id_by_title(
        self,
        title: str,
    ) -> str | None:
        """Re-resolve a KDE window ID from its current title."""
        if not title:
            return None

        result = self._wdotool_command(
            "search",
            "--name",
            title,
            "--ignore-case",
        )

        if result.returncode != 0:
            return None

        candidates = []

        for line in result.stdout.splitlines():
            line = line.strip()

            if not line:
                continue

            window_id = line.split(None, 1)[0]

            title_result = self._wdotool_command(
                "getwindowname",
                window_id,
            )

            if title_result.returncode != 0:
                continue

            actual_title = title_result.stdout.strip()

            if actual_title == title:
                return window_id

            candidates.append((window_id, actual_title))

        # Fallback for titles that changed slightly since capture.
        if candidates:
            lowered = title.lower()

            for window_id, actual_title in candidates:
                if actual_title.lower() == lowered:
                    return window_id

        return None

    def _activate_window(self, window: WindowInfo):
        if self._is_kde_wayland():
            window_id = window.window_id

            # IDs returned by getactivewindow may not remain usable across
            # separate wdotool/KWin invocations on this experimental backend.
            # Re-resolve by exact title before activation.
            resolved_id = self._find_kde_window_id_by_title(
                window.title,
            )

            if resolved_id:
                window_id = resolved_id

            result = self._wdotool_command(
                "windowactivate",
                window_id,
            )

            if result.returncode != 0:
                detail = (
                    result.stderr.strip()
                    or result.stdout.strip()
                    or f"exit code {result.returncode}"
                )

                raise AutomationError(
                    f'Could not focus window "{window.title}": {detail}'
                )

            time.sleep(0.35)

            active = self._get_active_window()

            # On KDE we verify the title, not the previously captured ID.
            if active.title != window.title:
                raise AutomationError(
                    f'wdotool activation was not confirmed for "{window.title}". '
                    f'Active window is "{active.title}".'
                )

            return

        if shutil.which("wmctrl"):
            result = self._run_window_command(
                "wmctrl",
                "-ia",
                window.window_id,
            )

            if result.returncode == 0:
                time.sleep(0.25)
                return

        if shutil.which("xdotool"):
            result = self._run_window_command(
                "xdotool",
                "windowactivate",
                "--sync",
                window.window_id,
            )

            if result.returncode == 0:
                time.sleep(0.25)
                return

        raise AutomationError(
            f'Could not focus window "{window.title}".'
        )

    def find_game_window(self) -> WindowInfo:
        if self._is_kde_wayland():
            search_order = [
                "Sober",
                self.game_window_pattern.strip(),
                "Roblox",
            ]

            seen: set[str] = set()

            for pattern in search_order:
                normalized = pattern.lower()

                if not normalized or normalized in seen:
                    continue

                seen.add(normalized)

                result = self._wdotool_command(
                    "search",
                    "--name",
                    pattern,
                    "--ignore-case",
                )

                if result.returncode != 0:
                    continue

                matches = []

                for line in result.stdout.splitlines():
                    line = line.strip()

                    if not line:
                        continue

                    # wdotool returns:
                    #   {internal-id} Window Title
                    # Keep only the window ID.
                    window_id = line.split(None, 1)[0]
                    matches.append(window_id)

                if not matches:
                    continue

                # Prefer an exact title match.
                for window_id in matches:
                    title_result = self._wdotool_command(
                        "getwindowname",
                        window_id,
                    )

                    if title_result.returncode != 0:
                        continue

                    title = title_result.stdout.strip()

                    if title.lower() == normalized:
                        return WindowInfo(
                            window_id=window_id,
                            title=title,
                        )

                # Otherwise use the first substring match.
                window_id = matches[0]

                title_result = self._wdotool_command(
                    "getwindowname",
                    window_id,
                )

                title = (
                    title_result.stdout.strip()
                    if title_result.returncode == 0
                    else pattern
                )

                return WindowInfo(
                    window_id=window_id,
                    title=title,
                )

            raise AutomationError(
                "Could not find Sober or Roblox through wdotool."
            )

        pattern = self.game_window_pattern.strip()

        if not pattern:
            raise AutomationError(
                "Game window search text is empty."
            )

        windows = self._list_windows()
        lowered = pattern.lower()

        exact = [
            window
            for window in windows
            if window.title.lower() == lowered
        ]

        if exact:
            return exact[0]

        partial = [
            window
            for window in windows
            if lowered in window.title.lower()
        ]

        if partial:
            return partial[0]

        raise AutomationError(
            f'No window matched "{pattern}".'
        )

    # =========================================================
    # Validation
    # =========================================================

    def _validate_item(self, item: AutomationItem):
        if not item.search_text.strip():
            raise AutomationError(
                f"{item.name}: search text is empty."
            )

        missing = item.coordinates.missing()

        if missing:
            raise AutomationError(
                f"{item.name}: missing coordinates: "
                + ", ".join(missing)
            )

        if item.cooldown_seconds < 0:
            raise AutomationError(
                f"{item.name}: cooldown cannot be negative."
            )

    def _validate_items(self):
        enabled = [
            item
            for item in self.items
            if item.enabled
        ]

        if not enabled:
            raise AutomationError(
                "No enabled automation items."
            )

        for item in enabled:
            self._validate_item(item)

    # =========================================================
    # Runtime
    # =========================================================

    def start(self):
        if self.status.running:
            return

        if not self.status.authenticated:
            raise AutomationError(
                "Input Access is not authenticated."
            )

        self._validate_items()

        self._stop_event.clear()

        self.status.running = True
        self.status.testing = False
        self.status.message = "RUNNING"
        self.status.next_run_timestamp = None
        self._emit_status()

        self._thread = threading.Thread(
            target=self._worker,
            name="solsrng-automation",
            daemon=True,
        )
        self._thread.start()

    def test_item(self, item: AutomationItem):
        if self.status.testing:
            return

        if not self.status.authenticated:
            raise AutomationError(
                "Input Access is not authenticated."
            )

        self._validate_item(item)

        self.status.testing = True
        self.status.message = (
            f"TESTING • {item.name}"
        )
        self.status.current_item = item.name
        self._emit_status()

        try:
            self._run_item(item)

            self.status.message = (
                f"TEST COMPLETE • {item.name}"
            )

        except Exception as exc:
            self.status.message = (
                f"TEST ERROR • {exc}"
            )
            raise

        finally:
            self.status.testing = False
            self.status.current_item = ""
            self._emit_status()

    def stop(self):
        self._stop_event.set()

        self.status.running = False
        self.status.testing = False
        self.status.message = "STOPPED"
        self.status.current_item = ""
        self.status.next_run_timestamp = None

        self._emit_status()

    def shutdown(self):
        self.stop()

        daemon = self._owned_ydotoold

        if (
            daemon is not None
            and daemon.poll() is None
        ):
            try:
                daemon.send_signal(
                    signal.SIGTERM
                )
            except Exception:
                pass

        self._owned_ydotoold = None

    # =========================================================
    # Scheduler
    # =========================================================

    def _worker(self):
        enabled = [
            item
            for item in self.items
            if item.enabled
        ]

        next_available = {
            index: 0.0
            for index in range(
                len(enabled)
            )
        }

        try:
            while not self._stop_event.is_set():
                now = time.monotonic()

                due = [
                    (
                        index,
                        item,
                    )
                    for index, item in enumerate(
                        enabled
                    )
                    if next_available[index] <= now
                ]

                if not due:
                    wait_until = min(
                        next_available.values()
                    )

                    wait_seconds = max(
                        0.05,
                        wait_until - now,
                    )

                    self.status.message = "WAITING"
                    self.status.current_item = ""
                    self.status.next_run_timestamp = (
                        time.time()
                        + wait_seconds
                    )
                    self._emit_status()

                    if self._stop_event.wait(
                        wait_seconds
                    ):
                        break

                    continue

                index, item = due[0]

                self.status.current_item = item.name
                self.status.message = (
                    f"RUNNING • {item.name}"
                )
                self.status.next_run_timestamp = None
                self._emit_status()

                self._run_item(item)

                next_available[index] = (
                    time.monotonic()
                    + max(
                        0.0,
                        item.cooldown_seconds,
                    )
                )

        except Exception as exc:
            self.status.running = False
            self.status.message = (
                f"ERROR • {exc}"
            )
            self.status.current_item = ""
            self.status.next_run_timestamp = None
            self._emit_status()

    # =========================================================
    # Actual click sequence
    # =========================================================

    def _run_item(self, item: AutomationItem):
        previous = self._get_active_window()
        game = self.find_game_window()

        self.status.previous_window = (
            previous.title
        )
        self.status.game_window = (
            game.title
        )
        self._emit_status()

        self._activate_window(game)

        try:
            self._click(
                item.coordinates.inventory
            )
            self._sleep(
                item.click_delay_seconds
            )

            self._click(
                item.coordinates.items
            )
            self._sleep(
                item.click_delay_seconds
            )

            self._click(
                item.coordinates.search_bar
            )
            self._sleep(
                item.click_delay_seconds
            )

            self._ctrl_a()

            self._type_text(
                item.search_text
            )
            self._sleep(
                item.click_delay_seconds
            )

            self._click(
                item.coordinates.first_slot
            )
            self._sleep(
                item.click_delay_seconds
            )

            self._click(
                item.coordinates.quantity
            )
            self._sleep(0.05)

            self._ctrl_a()

            self._type_text("1")
            self._sleep(
                item.click_delay_seconds
            )

            self._click(
                item.coordinates.use_button
            )
            self._sleep(
                item.post_use_delay_seconds
            )

            self._click(
                item.coordinates.close_inventory
            )
            self._sleep(
                item.click_delay_seconds
            )

        finally:
            try:
                self._activate_window(
                    previous
                )
            finally:
                self.status.game_window = ""
                self.status.previous_window = ""
                self._emit_status()

    # =========================================================
    # Mouse / keyboard
    # =========================================================

    def _run_input(self, *args: str):
        backend = self._resolve_backend()

        environment = os.environ.copy()

        # KDE Wayland:
        # - wdotool is used for window management only.
        # - ydotool uses the SolsRNGCore-owned socket for actual input.
        if self._is_kde_wayland() and backend in {"auto", "wdotool"}:
            backend = "ydotool"

        if backend == "ydotool":
            if self._socket_path is None:
                raise AutomationError(
                    "SolsRNGCore ydotool socket is not available."
                )

            socket_path = str(self._socket_path)

            if not os.path.exists(socket_path):
                raise AutomationError(
                    f"SolsRNGCore ydotool socket is missing: {socket_path}"
                )

            environment["YDOTOOL_SOCKET"] = socket_path

            command = [
                "ydotool",
                *args,
            ]

        else:
            command = [
                "xdotool",
                *args,
            ]

        try:
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                check=False,
                env=environment,
                timeout=10.0,
            )
        except subprocess.TimeoutExpired:
            raise AutomationError(
                "Input command timed out."
            )

        if result.returncode != 0:
            detail = (
                result.stderr.strip()
                or result.stdout.strip()
                or f"exit code {result.returncode}"
            )

            raise AutomationError(
                f"Input command failed: {detail}"
            )

    def _click(self, coordinate):
        if coordinate is None:
            raise AutomationError(
                "Missing click coordinate."
            )

        x, y = coordinate
        backend = self._resolve_backend()

        if backend == "ydotool":
            self._run_input(
                "mousemove",
                "--absolute",
                str(int(x)),
                str(int(y)),
            )
            self._run_input(
                "click",
                "0xC0",
            )
            return

        self._run_input(
            "mousemove",
            str(int(x)),
            str(int(y)),
        )
        self._run_input(
            "click",
            "1",
        )

    def _type_text(self, text: str):
        if self._resolve_backend() == "ydotool":
            self._run_input(
                "type",
                text,
            )
            return

        self._run_input(
            "type",
            "--delay",
            "0",
            text,
        )

    def _ctrl_a(self):
        if self._resolve_backend() == "ydotool":
            self._run_input(
                "key",
                "29:1",
                "30:1",
                "30:0",
                "29:0",
            )
            return

        self._run_input(
            "key",
            "ctrl+a",
        )

    @staticmethod
    def _sleep(seconds: float):
        if seconds > 0:
            time.sleep(seconds)

    def _emit_status(self):
        callback = self.on_status

        if callback is None:
            return

        try:
            callback(
                self.status
            )
        except Exception:
            pass
